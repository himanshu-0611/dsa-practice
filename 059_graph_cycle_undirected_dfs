class Solution {
  public:
    bool dfsHelper(
        int src,
        unordered_map<int, vector<int>>& adjList,
        int parent,
        unordered_map<int, bool>& visited
    ) {
        visited[src] = true;
        cout << "current processing: " << src << endl;
        // process neighbours
        for (auto nbr : adjList[src]) {
            if (!visited[nbr]) {
                // recursive call
                bool ans = dfsHelper(nbr, adjList, src, visited);
                if (ans == true) {
                    return true;
                }
            }
            else if (nbr != parent) {
                // visited neighbour that's not the parent → cycle
                return true;
            }
        }
        
        return false;
    }

    bool checkCycleUsingDfs(unordered_map<int, vector<int>>& adjList, int V) {
        unordered_map<int, bool> visited;
        
        // handle disconnected components
        for (int src = 0; src < V; src++) {
            if (!visited[src]) {
                if (dfsHelper(src, adjList, -1, visited)) {
                    return true;
                }
            }
        }
        
        return false;
    }

    bool isCycle(int V, vector<vector<int>>& edges) {
        unordered_map<int, vector<int>> adjList;
        
        for (auto i : edges) {
            int u = i[0];
            int v = i[1];
            adjList[u].push_back(v);
            adjList[v].push_back(u);
        }
        
        return checkCycleUsingDfs(adjList, V);
    }
};
