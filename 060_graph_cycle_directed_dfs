class Solution {
  public:
    bool dfsHelper(
        int src,
        unordered_map<int, vector<int>>& adjList,
        unordered_map<int, bool>& visited,
        unordered_map<int, bool>& dfsTracker
        ) {
            visited[src] = true;
            dfsTracker[src] = true;
            
            //nbr process
            for(auto nbr : adjList[src]) {
                if(!visited[nbr]) {
                    int ans = dfsHelper(nbr, adjList, visited, dfsTracker);
                    if(ans == true) {
                        return true;
                    }
                }
                // else if(visited[nbr] == true && dfsTracker[nbr] == true) {
                else if(visited[nbr] == true) {
                    //cycle present
                    return true;
                }
            }
            
        //ye me bhul jata hu
        // dfsTracker[src] = false;
        return false;
    }
    bool checkCycleUsingDfs(int V, unordered_map<int, vector<int>>& adjList) {
        unordered_map<int, bool> visited;
        unordered_map<int, bool> dfsTracker;
        
        //disconnected components
        for(int src = 0; src<V; src++) {
            if(!visited[src]) {
                bool ans = dfsHelper(src, adjList, visited, dfsTracker);
                if(ans == true) {
                    return true;
                }
            }
        }
        
        return false;
    }
    bool isCyclic(int V, vector<vector<int>> &edges) {
        // code here
        unordered_map<int, vector<int>> adjList;
        
        for(auto i : edges) {
            //i->vector<int>
            int u = i[0];
            int v = i[1];
            //u--v
            //u->v, v->u
            adjList[u].push_back(v);
        }
        
        bool ans = checkCycleUsingDfs(V, adjList);
        return ans;
    }
};